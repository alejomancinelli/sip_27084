/* ============================================================
   Tema oscuro.

   Único lugar donde se pintan los widgets estándar de la UI: ningún
   widget de ui/ llama a setStyleSheet() por su cuenta. Lo que el QSS no
   alcanza —QPainter, series de QtCharts, items de tabla— saca sus colores
   de ui/theme.py, que define las mismas claves para los dos temas.

   Los selectores por propiedad (state, active, selected) los alimentan
   los widgets con setProperty() + unpolish/polish. Agregar un estado es
   una regla acá y otra en light.qss.
   ============================================================ */

QMainWindow {
    background-color: #505050;
    color: #e5e5e5;
}
QWidget {
    background-color: #3c3c3c;
    color: #e5e5e5;
    font-size: 10pt;
}

/* ── Estructura de la ventana ───────────────────────────────── */

QWidget#appHeader {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                      stop:0 rgb(58,58,58), stop:1 rgb(120,120,120));
}
QWidget#appHeader QLabel {
    background: transparent;
}
QLabel#appTitle {
    color: #e5e5e5;
    font-size: 14pt;
    font-weight: bold;
}
QLabel#headerClock {
    color: #e5e5e5;
    background: rgba(0,0,0,40);
    border-radius: 12px;
    padding: 4px 12px;
    font-size: 11pt;
}
/* Divisor del header: un QWidget con fondo, no un QFrame(VLine), que se pinta
   desde la paleta y no desde el QSS. */
QWidget#headerSeparator {
    background-color: rgba(255,255,255,70);
}
/* Grupo de controles del header: transparente para no tapar el degradado. */
QWidget#headerGroup {
    background: transparent;
}
QWidget#appFooter {
    background-color: #2c2c2c;
}
QLabel#footerMessage {
    color: #e5e5e5;
    font-size: 9pt;
}
/* La versión, más apagada que el mensaje: es referencia, no un aviso. */
QLabel#footerVersion {
    color: #9aa3ad;
    font-size: 9pt;
}
QLabel#viewTitle {
    font-size: 14pt;
    font-weight: bold;
}
QLabel#hintLabel {
    color: #9aa3ad;
    font-size: 9pt;
}
QLabel#warningBanner {
    background: rgba(255,252,160,150);
    color: #856404;
    border-radius: 6px;
    padding: 6px;
    font-weight: bold;
}

/* Tarjeta de fondo de una pestaña (un poco más clara que el panel) */
QWidget#configCard {
    background-color: #484848;
}
QWidget#configCard > QWidget {
    background-color: #484848;
}

/* ── GroupBox y labels ──────────────────────────────────────── */

QGroupBox {
    background-color: #393939;
    border: 1px solid #767e89;
    border-radius: 4px;
    margin-top: 20px;
    padding: 8px;
    color: #e5e5e5;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 2px 6px;
    color: #e5e5e5;
    font-weight: bold;
    background-color: transparent;
}
QLabel {
    color: #e5e5e5;
    background-color: transparent;
}

/* ── Chips de estado ────────────────────────────────────────── */

QLabel#statusChip {
    border-radius: 8px;
    padding: 5px;
    font-weight: bold;
    color: black;
    background-color: rgba(255,252,160,150);
}
QLabel#statusChip[state="ok"]      { background-color: rgba(190,255,190,120); }
QLabel#statusChip[state="error"]   { background-color: rgba(255,190,190,120); }
QLabel#statusChip[state="info"]    { background-color: rgb(169,215,255); }
QLabel#statusChip[state="warning"] { background-color: rgba(255,252,160,150); }

/* ── Feed de video ──────────────────────────────────────────── */

QLabel#videoFeed {
    background-color: #000000;
    color: #e5e5e5;
    font-weight: bold;
}

/* ── Botones ────────────────────────────────────────────────── */

QPushButton {
    background-color: #0d6efd;
    color: white;
    border: 2px solid white;
    border-radius: 5px;
    padding: 10px;
    font-weight: bold;
}
QPushButton:hover   { background-color: #0b5ed7; }
QPushButton:pressed { background-color: rgb(6,52,116); }
QPushButton:disabled {
    background-color: #555555;
    color: #888888;
    border-color: #666666;
}

QPushButton#navButton,
QPushButton#headerButton {
    background: transparent;
    color: #cccccc;
    border: none;
    border-radius: 5px;
    padding: 8px 18px;
    font-weight: bold;
    font-size: 10pt;
}
QPushButton#headerButton {
    border: 1px solid rgba(255,255,255,80);
    padding: 6px 22px;
    min-width: 56px;
}
QPushButton#navButton:hover,
QPushButton#headerButton:hover { background: rgba(255,255,255,30); }
QPushButton#navButton[active="true"] {
    background: #0d6efd;
    color: white;
}
QPushButton#navButton[active="true"]:hover { background: #0b5ed7; }

QPushButton#saveButton  { background: #0d6efd; border: none; padding: 10px 20px; }
QPushButton#discardButton, QPushButton#cancelButton {
    background: rgb(100,100,100);
    border: none;
    padding: 10px 20px;
}
QPushButton#discardButton { background: rgb(179,67,67); }
QPushButton#discardButton:hover { background: rgb(200,80,80); }
QPushButton#resetButton {
    background: rgb(130,80,0);
    border: none;
    padding: 8px 16px;
}
QPushButton#resetButton:hover { background: rgb(170,105,0); }
QPushButton#clearButton {
    background: #5a3030;
    border: 1px solid #7a4040;
    border-radius: 3px;
    padding: 2px 8px;
    font-size: 9pt;
}
QPushButton#clearButton:hover { background: #6a3838; }

QPushButton#logFilterButton {
    background: #505050;
    color: #cccccc;
    border: 1px solid #666666;
    border-radius: 3px;
    padding: 2px 8px;
    font-size: 9pt;
    font-weight: normal;
}
QPushButton#logFilterButton:hover { background: #606060; }
QPushButton#logFilterButton[selected="true"] {
    background: #0d6efd;
    color: white;
    border: none;
    font-weight: bold;
}

/* Tira de colapso del panel lateral del monitor */
QPushButton#sidebarToggle {
    background-color: #2a2a2a;
    color: #aaaaaa;
    border: none;
    border-left: 1px solid #444444;
    border-radius: 0;
    padding: 0;
    font-size: 8pt;
    font-weight: normal;
}
QPushButton#sidebarToggle:hover {
    background-color: #3a3a3a;
    color: white;
}

/* ── GPIO ───────────────────────────────────────────────────── */

QLabel#gpioIndicator, QPushButton#gpioOutput {
    border-radius: 8px;
    font-weight: bold;
}
QLabel#gpioIndicator[state="high"] {
    background-color: rgba(190,255,190,200);
    color: #155724;
    border: 2px solid #28a745;
}
QLabel#gpioIndicator[state="low"] {
    background-color: rgba(255,190,190,180);
    color: #721c24;
    border: 2px solid #dc3545;
}
QLabel#gpioIndicator[state="unknown"] {
    background-color: rgba(255,252,160,150);
    color: #856404;
    border: 2px solid #ffc107;
}
QPushButton#gpioOutput[state="high"] {
    background: #198754;
    color: white;
    border: 2px solid #28a745;
}
QPushButton#gpioOutput[state="high"]:hover { background: #157347; }
QPushButton#gpioOutput[state="low"] {
    background: rgb(100,100,100);
    color: white;
    border: none;
}
QPushButton#gpioOutput[state="low"]:hover { background: rgb(130,130,130); }

/* ── Inputs ─────────────────────────────────────────────────── */

QLineEdit {
    background-color: #444444;
    color: #e5e5e5;
    border: 1px solid #555555;
    border-radius: 3px;
    padding: 4px;
}
QLineEdit:focus {
    border-color: #28a2a2;
    border-width: 2px;
}
QLineEdit#readonlyField {
    background-color: #2e2e2e;
    color: #999999;
    border-color: #444444;
    font-family: monospace;
}
QLineEdit:disabled {
    background-color: #444444;
    color: #999999;
}

QSpinBox, QDoubleSpinBox {
    background-color: #2c2c2c;
    color: #e5e5e5;
    border: 1px solid #555555;
    border-radius: 3px;
    padding: 2px 4px;
}
QSpinBox:disabled, QDoubleSpinBox:disabled {
    color: #999999;
}

QComboBox {
    background-color: #2c2c2c;
    color: #e5e5e5;
    border: 1px solid #555555;
    border-radius: 3px;
    padding: 4px;
}
QComboBox:disabled { color: #999999; }
QComboBox::drop-down {
    border: none;
    width: 20px;
    background-color: #444444;
}
QComboBox QAbstractItemView {
    background-color: #2c2c2c;
    color: #e5e5e5;
    border: 1px solid #555555;
    selection-background-color: #555555;
    selection-color: #ffffff;
}

QCheckBox { color: #e5e5e5; }
QCheckBox:disabled { color: #999999; }
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #767e89;
    border-radius: 3px;
    background-color: #2c2c2c;
}
QCheckBox::indicator:checked { background-color: #0d6efd; }
QCheckBox::indicator:disabled { border: 1px solid #555555; }

/* ── Pestañas, tablas y scroll ──────────────────────────────── */

QTabWidget::pane {
    border: 1px solid #555555;
    background-color: #3c3c3c;
}
QTabBar::tab {
    background-color: #2c2c2c;
    color: #aaaaaa;
    padding: 8px 0;
    min-width: 140px;
    border-radius: 4px 4px 0 0;
}
QTabBar::tab:selected {
    background-color: #3c3c3c;
    color: #e5e5e5;
    font-weight: bold;
}
QTabBar::tab:hover:!selected { background-color: #363636; }

QScrollArea {
    border: none;
    background-color: transparent;
}

QTableWidget {
    background-color: #3c3c3c;
    color: #e5e5e5;
    border: none;
    gridline-color: #4a4a4a;
    font-size: 9pt;
}
QHeaderView::section {
    background-color: #484848;
    color: #e5e5e5;
    padding: 4px;
    border: none;
    font-weight: bold;
}
QTableWidget::item:selected {
    background-color: rgb(106,106,106);
    color: white;
}

QScrollBar:vertical {
    background: #2c2c2c;
    width: 10px;
    border-radius: 5px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #555555;
    border-radius: 5px;
    min-height: 20px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background: #2c2c2c;
    height: 10px;
    border-radius: 5px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #555555;
    border-radius: 5px;
    min-width: 20px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
